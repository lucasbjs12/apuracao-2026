# Copie para .env.local (desenvolvimento) e cadastre os mesmos valores na Cloudflare
# (Workers & Pages → seu projeto → Settings → Variables and Secrets / Build variables).
# Como o site é estático, as variáveis entram no build: mudou uma, faça um novo deploy.

# Domínio final, sem barra no fim. Usado no SEO, sitemap e links de compartilhamento.
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
NEXT_PUBLIC_SITE_NAME=Apuração ao Vivo 2026
NEXT_PUBLIC_CONTATO_EMAIL=contato@seudominio.com.br

# Google AdSense (deixe vazio até a conta ser aprovada).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_TOPO=
NEXT_PUBLIC_AD_SLOT_MEIO=
NEXT_PUBLIC_AD_SLOT_RODAPE=

# Modo simulação (?demo=1). Use 1 só no seu computador, NUNCA no build de produção.
NEXT_PUBLIC_ALLOW_DEMO=1

# WhatsApp de vendas da loja (só números, com DDD). Vazio = produtos aparecem como "Em breve".
NEXT_PUBLIC_WHATSAPP_LOJA=
