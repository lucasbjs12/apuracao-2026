# Cabeçalhos usados pela Cloudflare (Pages / Workers static assets).

# Imagem de prévia do WhatsApp é gerada sem extensão.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Arquivos do build têm hash no nome: podem ficar em cache "para sempre".
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Páginas HTML: sempre revalidar, para um novo deploy chegar na hora.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
